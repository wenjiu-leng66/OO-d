# Copy to deploy/.env on the server. Never commit the filled file.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
MYSQL_DATABASE=rbac
MYSQL_USER=rbac
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD
# Synthetic accounts are opt-in and are seeded only into an empty database.
# 此示例为一期合成验收配置；正式资料库应关闭演示种子，并通过受控离线流程导入数据。
RBAC_DEMO_ENABLED=true
RBAC_INITIAL_PASSWORD=REPLACE_WITH_PRIVATE_DEMO_PASSWORD
# false for the documented HTTP course demo. Set true when serving HTTPS.
# 在 HTTP 下设为 true 会导致浏览器不发送 Cookie；不要把更改此开关当作已经配置 TLS。
SESSION_COOKIE_SECURE=false
